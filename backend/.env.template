# Base de datos (Neon / Postgres)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=landing

# WhatsApp destino (número con código de país, sin +)
WA_NUMBER=

# Prefijo de claves de acceso (ej: QF → QF-1234)
ACCESS_CODE_PREFIX=QF

# Responsables asignados en round-robin (opcional, separados por coma)
# LEAD_RESPONSABLES=Persona A,Persona B

# CORS - orígenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:5173

# URL pública de la landing (para Meta CAPI)
LANDING_URL=http://localhost:5173/acceso/

# Meta Conversions API
META_PIXEL_ID=
META_CAPI_TOKEN=

# JWT secret — usado por ecosystem auth y sesión admin
SECRET=

# Panel admin — se usa solo la primera vez para crear el usuario en BD (tabla admin_users)
ADMIN_USER=alicia
ADMIN_PASSWORD=
